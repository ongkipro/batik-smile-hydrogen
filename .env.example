# Environment variables for Batik Smile Hydrogen Storefront
# Production Domain: https://batiksmile.com
# Internal Store Domain: 23ahbp-sq.myshopify.com

# Public Storefront API domain
PUBLIC_STORE_DOMAIN="batiksmile.com"

# Public Storefront API token (obtained from Shopify Admin -> Headless / Hydrogen channel)
PUBLIC_STOREFRONT_API_TOKEN="your_storefront_access_token_here"

# Storefront API version
PUBLIC_STOREFRONT_API_VERSION="2026-01"

# Production Custom Domain, Checkout Domain & Customer Account Domain
PUBLIC_CHECKOUT_DOMAIN="checkout.batiksmile.com"
PUBLIC_ACCOUNT_DOMAIN="account.batiksmile.com"

# Storefront & Shop Identifiers
PUBLIC_STOREFRONT_ID="1000176204"
SHOP_ID="81332240441"

# Customer Account API (Headless authentication)
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID="914fd250-3bb8-4e2a-b629-eac000234ead"
PUBLIC_CUSTOMER_ACCOUNT_API_URL="https://account.batiksmile.com"

# Session secret for cookie encryption
SESSION_SECRET="your_random_session_secret_key_here"
